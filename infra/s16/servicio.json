{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "S16: API real Fargate en red propia, entrada /32, sin NAT, ALB ni base de datos.",
  "Parameters": {
    "Lab": {"Type": "String", "AllowedPattern": "s16-[a-z0-9-]{3,30}"},
    "ImageUri": {"Type": "String", "AllowedPattern": ".+@sha256:[a-f0-9]{64}"},
    "AppVersion": {"Type": "String", "AllowedPattern": "[A-Za-z0-9._-]{1,80}"},
    "AllowedCidr": {"Type": "String", "AllowedPattern": "([0-9]{1,3}\\.){3}[0-9]{1,3}/32"},
    "SecretArn": {"Type": "String", "AllowedPattern": "arn:aws:secretsmanager:.+"},
    "ModelId": {"Type": "String", "MinLength": 1, "MaxLength": 160},
    "KmsKeyArn": {"Type": "String", "Default": "", "Description": "Solo si el secreto usa KMS propia"}
  },
  "Conditions": {
    "KmsPropia": {"Fn::Not": [{"Fn::Equals": [{"Ref": "KmsKeyArn"}, ""]}]}
  },
  "Resources": {
    "Vpc": {"Type": "AWS::EC2::VPC", "Properties": {"CidrBlock": "10.216.0.0/24", "EnableDnsSupport": true, "EnableDnsHostnames": true}},
    "Gateway": {"Type": "AWS::EC2::InternetGateway"},
    "Conexion": {"Type": "AWS::EC2::VPCGatewayAttachment", "Properties": {"VpcId": {"Ref": "Vpc"}, "InternetGatewayId": {"Ref": "Gateway"}}},
    "Subred": {"Type": "AWS::EC2::Subnet", "Properties": {"VpcId": {"Ref": "Vpc"}, "CidrBlock": "10.216.0.0/25", "MapPublicIpOnLaunch": false}},
    "TablaRutas": {"Type": "AWS::EC2::RouteTable", "Properties": {"VpcId": {"Ref": "Vpc"}}},
    "RutaInternet": {"Type": "AWS::EC2::Route", "DependsOn": "Conexion", "Properties": {"RouteTableId": {"Ref": "TablaRutas"}, "DestinationCidrBlock": "0.0.0.0/0", "GatewayId": {"Ref": "Gateway"}}},
    "Asociacion": {"Type": "AWS::EC2::SubnetRouteTableAssociation", "Properties": {"SubnetId": {"Ref": "Subred"}, "RouteTableId": {"Ref": "TablaRutas"}}},
    "Firewall": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "VpcId": {"Ref": "Vpc"}, "GroupDescription": "Solo profesor /32, salida TLS del laboratorio",
        "SecurityGroupIngress": [{"IpProtocol": "tcp", "FromPort": 8000, "ToPort": 8000, "CidrIp": {"Ref": "AllowedCidr"}}],
        "SecurityGroupEgress": [{"IpProtocol": "tcp", "FromPort": 443, "ToPort": 443, "CidrIp": "0.0.0.0/0"}]
      }
    },
    "Logs": {"Type": "AWS::Logs::LogGroup", "Properties": {"LogGroupName": {"Fn::Sub": "/thepower/${Lab}"}, "RetentionInDays": 7}},
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Service": "ecs-tasks.amazonaws.com"}, "Action": "sts:AssumeRole"}]},
        "Policies": [{"PolicyName": "arranque-contenedor", "PolicyDocument": {"Version": "2012-10-17", "Statement": [
          {"Effect": "Allow", "Action": "ecr:GetAuthorizationToken", "Resource": "*"},
          {"Effect": "Allow", "Action": ["ecr:BatchCheckLayerAvailability", "ecr:GetDownloadUrlForLayer", "ecr:BatchGetImage"], "Resource": {"Fn::Sub": "arn:${AWS::Partition}:ecr:${AWS::Region}:${AWS::AccountId}:repository/${Lab}"}},
          {"Effect": "Allow", "Action": ["logs:CreateLogStream", "logs:PutLogEvents"], "Resource": {"Fn::GetAtt": ["Logs", "Arn"]}},
          {"Effect": "Allow", "Action": "secretsmanager:GetSecretValue", "Resource": {"Ref": "SecretArn"}},
          {"Fn::If": ["KmsPropia", {"Effect": "Allow", "Action": "kms:Decrypt", "Resource": {"Ref": "KmsKeyArn"}}, {"Ref": "AWS::NoValue"}]}
        ]}}]
      }
    },
    "TaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Service": "ecs-tasks.amazonaws.com"}, "Action": "sts:AssumeRole"}]}
      }
    },
    "Cluster": {"Type": "AWS::ECS::Cluster", "Properties": {"ClusterName": {"Ref": "Lab"}}},
    "Tarea": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": {"Ref": "Lab"}, "Cpu": "256", "Memory": "512", "NetworkMode": "awsvpc",
        "RequiresCompatibilities": ["FARGATE"],
        "RuntimePlatform": {"CpuArchitecture": "X86_64", "OperatingSystemFamily": "LINUX"},
        "ExecutionRoleArn": {"Fn::GetAtt": ["ExecutionRole", "Arn"]},
        "TaskRoleArn": {"Fn::GetAtt": ["TaskRole", "Arn"]},
        "ContainerDefinitions": [{
          "Name": "api", "Image": {"Ref": "ImageUri"}, "Essential": true,
          "User": "10001:10001", "ReadonlyRootFilesystem": true,
          "PortMappings": [{"ContainerPort": 8000, "Protocol": "tcp"}],
          "Environment": [
            {"Name": "API_MODE", "Value": "real"}, {"Name": "MODEL_ID", "Value": {"Ref": "ModelId"}},
            {"Name": "APP_VERSION", "Value": {"Ref": "AppVersion"}}
          ],
          "Secrets": [{"Name": "ANTHROPIC_API_KEY", "ValueFrom": {"Ref": "SecretArn"}}],
          "HealthCheck": {
            "Command": ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2)"],
            "Interval": 30, "Timeout": 5, "Retries": 3, "StartPeriod": 20
          },
          "LogConfiguration": {"LogDriver": "awslogs", "Options": {"awslogs-group": {"Ref": "Logs"}, "awslogs-region": {"Ref": "AWS::Region"}, "awslogs-stream-prefix": "api", "mode": "non-blocking", "max-buffer-size": "1m"}}
        }]
      }
    },
    "Servicio": {
      "Type": "AWS::ECS::Service", "DependsOn": ["RutaInternet", "Asociacion"],
      "Properties": {
        "ServiceName": {"Ref": "Lab"}, "Cluster": {"Ref": "Cluster"}, "TaskDefinition": {"Ref": "Tarea"},
        "DesiredCount": 1, "LaunchType": "FARGATE", "PlatformVersion": "1.4.0",
        "DeploymentConfiguration": {"MinimumHealthyPercent": 0, "MaximumPercent": 100, "DeploymentCircuitBreaker": {"Enable": true, "Rollback": true}},
        "NetworkConfiguration": {"AwsvpcConfiguration": {"AssignPublicIp": "ENABLED", "Subnets": [{"Ref": "Subred"}], "SecurityGroups": [{"Ref": "Firewall"}]}}
      }
    }
  },
  "Outputs": {
    "Cluster": {"Value": {"Ref": "Cluster"}}, "Service": {"Value": {"Fn::GetAtt": ["Servicio", "Name"]}},
    "TaskDefinition": {"Value": {"Ref": "Tarea"}}, "LogGroup": {"Value": {"Ref": "Logs"}},
    "ImageUri": {"Value": {"Ref": "ImageUri"}}, "AppVersion": {"Value": {"Ref": "AppVersion"}},
    "SecretArn": {"Value": {"Ref": "SecretArn"}}
  }
}
