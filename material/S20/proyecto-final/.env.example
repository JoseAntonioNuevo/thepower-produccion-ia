# Copia este archivo a .env y ajusta lo que necesites. Sin .env, el proyecto funciona en el
# perfil doble, en memoria y con las copias de aula: no hace falta ninguna clave.
#
# Los comandos leen el .env así:  uv run --env-file .env python -m agente.cli ...

# --- 1. Cerebro y embeddings ----------------------------------------------------------
# doble = reglas sin modelo ni coste (rotulado) · real = modelo de un proveedor (cuesta dinero)
S20_PERFIL=doble
# Solo con S20_PERFIL=real. Formato proveedor:modelo de LangChain.
# S20_MODELO_CHAT=google_genai:gemini-3.5-flash-lite
# S20_MODELO_EMBEDDINGS=gemini-embedding-2
# GOOGLE_API_KEY=            # nunca la subas a Git ni la pongas en una imagen

# --- 2. Memoria -----------------------------------------------------------------------
# memoria = RAM, se pierde al cerrar · postgres = PostgreSQL + pgvector (docker compose up -d --wait)
S20_ALMACEN=memoria
# S20_DATABASE_URL=postgresql://s20:s20_aula_local@127.0.0.1:54520/s20_agente

# --- 3. Límites del agente ------------------------------------------------------------
# S20_MAX_HERRAMIENTAS=4
# S20_K_FRAGMENTOS=3
# S20_UMBRAL_EVIDENCIA=0.20   # depende del modelo de embeddings: hay que medirlo (S19)

# --- 4. Investigación -----------------------------------------------------------------
# locales = copias de aula · red = descarga las URL de la lista blanca (gratis, necesita internet)
S20_FUENTES=locales
# S20_MAX_CONSULTAS=3
# S20_MAX_FUENTES=3

# --- 5. Identidad de laboratorio (token:usuario) ----------------------------------------
# S20_USUARIOS=token-ana:ana,token-luis:luis

# --- 6. Langfuse (opcional) -------------------------------------------------------------
# S20_LANGFUSE=1
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
