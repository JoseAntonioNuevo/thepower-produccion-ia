{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "S20 proyecto final: agente en ECS Fargate (API + ejecutor) con PostgreSQL privado en RDS. Entrada /32, sin NAT ni ALB.",
  "Parameters": {
    "Lab": {"Type": "String", "AllowedPattern": "s20-[a-z0-9-]{3,30}", "Description": "Nombre propio del laboratorio; tambien es el repositorio ECR"},
    "ImageUri": {"Type": "String", "AllowedPattern": ".+@sha256:[a-f0-9]{64}", "Description": "Imagen por digest: se despliega exactamente lo que se probo"},
    "AllowedCidr": {"Type": "String", "AllowedPattern": "([0-9]{1,3}\\.){3}[0-9]{1,3}/32", "Description": "Unica IPv4 que puede llamar a la API"},
    "Perfil": {"Type": "String", "Default": "doble", "AllowedValues": ["doble", "real"]},
    "ModeloChat": {"Type": "String", "Default": "google_genai:gemini-3.5-flash-lite", "MaxLength": 160},
    "ModeloEmbeddings": {"Type": "String", "Default": "gemini-embedding-2", "MaxLength": 160},
    "Usuarios": {"Type": "String", "NoEcho": true, "MinLength": 8, "Description": "token:usuario separados por comas. Tokens propios del laboratorio, no los del ejemplo"},
    "VersionPostgres": {"Type": "String", "Default": "17.11", "AllowedPattern": "17\\.[0-9]{1,2}", "Description": "Comprobar con: aws rds describe-db-engine-versions --engine postgres"},
    "ClaveModeloArn": {"Type": "String", "Default": "", "Description": "ARN del secreto con la clave del proveedor del modelo. Vacio en el perfil doble"}
  },
  "Conditions": {
    "ConClaveModelo": {"Fn::Not": [{"Fn::Equals": [{"Ref": "ClaveModeloArn"}, ""]}]}
  },
  "Resources": {
    "Vpc": {"Type": "AWS::EC2::VPC", "Properties": {"CidrBlock": "10.220.0.0/24", "EnableDnsSupport": true, "EnableDnsHostnames": true}},
    "Gateway": {"Type": "AWS::EC2::InternetGateway"},
    "Conexion": {"Type": "AWS::EC2::VPCGatewayAttachment", "Properties": {"VpcId": {"Ref": "Vpc"}, "InternetGatewayId": {"Ref": "Gateway"}}},
    "SubredPublica": {"Type": "AWS::EC2::Subnet", "Properties": {"VpcId": {"Ref": "Vpc"}, "CidrBlock": "10.220.0.0/26", "MapPublicIpOnLaunch": false, "AvailabilityZone": {"Fn::Select": [0, {"Fn::GetAZs": ""}]}}},
    "SubredDatosA": {"Type": "AWS::EC2::Subnet", "Properties": {"VpcId": {"Ref": "Vpc"}, "CidrBlock": "10.220.0.64/26", "AvailabilityZone": {"Fn::Select": [0, {"Fn::GetAZs": ""}]}}},
    "SubredDatosB": {"Type": "AWS::EC2::Subnet", "Properties": {"VpcId": {"Ref": "Vpc"}, "CidrBlock": "10.220.0.128/26", "AvailabilityZone": {"Fn::Select": [1, {"Fn::GetAZs": ""}]}}},
    "TablaRutas": {"Type": "AWS::EC2::RouteTable", "Properties": {"VpcId": {"Ref": "Vpc"}}},
    "RutaInternet": {"Type": "AWS::EC2::Route", "DependsOn": "Conexion", "Properties": {"RouteTableId": {"Ref": "TablaRutas"}, "DestinationCidrBlock": "0.0.0.0/0", "GatewayId": {"Ref": "Gateway"}}},
    "Asociacion": {"Type": "AWS::EC2::SubnetRouteTableAssociation", "Properties": {"SubnetId": {"Ref": "SubredPublica"}, "RouteTableId": {"Ref": "TablaRutas"}}},

    "FirewallAgente": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "VpcId": {"Ref": "Vpc"}, "GroupDescription": "Agente: entrada solo desde la IP del profesor, salida TLS",
        "SecurityGroupIngress": [{"IpProtocol": "tcp", "FromPort": 8020, "ToPort": 8020, "CidrIp": {"Ref": "AllowedCidr"}}],
        "SecurityGroupEgress": [{"IpProtocol": "tcp", "FromPort": 443, "ToPort": 443, "CidrIp": "0.0.0.0/0"}]
      }
    },
    "FirewallDatos": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {"VpcId": {"Ref": "Vpc"}, "GroupDescription": "PostgreSQL: solo acepta al agente", "SecurityGroupEgress": [{"IpProtocol": "-1", "CidrIp": "127.0.0.1/32"}]}
    },
    "AgenteHaciaDatos": {"Type": "AWS::EC2::SecurityGroupEgress", "Properties": {"GroupId": {"Ref": "FirewallAgente"}, "IpProtocol": "tcp", "FromPort": 5432, "ToPort": 5432, "DestinationSecurityGroupId": {"Ref": "FirewallDatos"}}},
    "DatosDesdeAgente": {"Type": "AWS::EC2::SecurityGroupIngress", "Properties": {"GroupId": {"Ref": "FirewallDatos"}, "IpProtocol": "tcp", "FromPort": 5432, "ToPort": 5432, "SourceSecurityGroupId": {"Ref": "FirewallAgente"}}},

    "GrupoSubredes": {"Type": "AWS::RDS::DBSubnetGroup", "Properties": {"DBSubnetGroupDescription": "Subredes privadas de la base del laboratorio", "SubnetIds": [{"Ref": "SubredDatosA"}, {"Ref": "SubredDatosB"}]}},
    "BaseDatos": {
      "Type": "AWS::RDS::DBInstance",
      "DeletionPolicy": "Delete",
      "UpdateReplacePolicy": "Delete",
      "Properties": {
        "Engine": "postgres", "EngineVersion": {"Ref": "VersionPostgres"}, "DBInstanceClass": "db.t4g.micro",
        "AllocatedStorage": "20", "StorageType": "gp3", "StorageEncrypted": true,
        "DBName": "s20_agente", "MasterUsername": "s20", "ManageMasterUserPassword": true,
        "PubliclyAccessible": false, "MultiAZ": false,
        "DBSubnetGroupName": {"Ref": "GrupoSubredes"}, "VPCSecurityGroups": [{"Ref": "FirewallDatos"}],
        "BackupRetentionPeriod": 1, "DeleteAutomatedBackups": true, "DeletionProtection": false,
        "AutoMinorVersionUpgrade": true
      }
    },

    "Logs": {"Type": "AWS::Logs::LogGroup", "DeletionPolicy": "Delete", "UpdateReplacePolicy": "Delete", "Properties": {"LogGroupName": {"Fn::Sub": "/thepower/${Lab}"}, "RetentionInDays": 3}},
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Service": "ecs-tasks.amazonaws.com"}, "Action": "sts:AssumeRole"}]},
        "Policies": [{"PolicyName": "arranque-contenedor", "PolicyDocument": {"Version": "2012-10-17", "Statement": [
          {"Effect": "Allow", "Action": "ecr:GetAuthorizationToken", "Resource": "*"},
          {"Effect": "Allow", "Action": ["ecr:BatchCheckLayerAvailability", "ecr:GetDownloadUrlForLayer", "ecr:BatchGetImage"], "Resource": {"Fn::Sub": "arn:${AWS::Partition}:ecr:${AWS::Region}:${AWS::AccountId}:repository/${Lab}"}},
          {"Effect": "Allow", "Action": ["logs:CreateLogStream", "logs:PutLogEvents"], "Resource": {"Fn::GetAtt": ["Logs", "Arn"]}},
          {"Effect": "Allow", "Action": "secretsmanager:GetSecretValue", "Resource": {"Fn::GetAtt": ["BaseDatos", "MasterUserSecret.SecretArn"]}},
          {"Fn::If": ["ConClaveModelo", {"Effect": "Allow", "Action": "secretsmanager:GetSecretValue", "Resource": {"Ref": "ClaveModeloArn"}}, {"Ref": "AWS::NoValue"}]}
        ]}}]
      }
    },
    "TaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Service": "ecs-tasks.amazonaws.com"}, "Action": "sts:AssumeRole"}]}
      }
    },
    "Cluster": {"Type": "AWS::ECS::Cluster", "Properties": {"ClusterName": {"Ref": "Lab"}}},
    "Tarea": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": {"Ref": "Lab"}, "Cpu": "512", "Memory": "1024", "NetworkMode": "awsvpc",
        "RequiresCompatibilities": ["FARGATE"],
        "RuntimePlatform": {"CpuArchitecture": "X86_64", "OperatingSystemFamily": "LINUX"},
        "ExecutionRoleArn": {"Fn::GetAtt": ["ExecutionRole", "Arn"]},
        "TaskRoleArn": {"Fn::GetAtt": ["TaskRole", "Arn"]},
        "ContainerDefinitions": [
          {
            "Name": "api", "Image": {"Ref": "ImageUri"}, "Essential": true,
            "PortMappings": [{"ContainerPort": 8020, "Protocol": "tcp"}],
            "Environment": [
              {"Name": "S20_PERFIL", "Value": {"Ref": "Perfil"}}, {"Name": "S20_ALMACEN", "Value": "postgres"},
              {"Name": "S20_MODELO_CHAT", "Value": {"Ref": "ModeloChat"}}, {"Name": "S20_MODELO_EMBEDDINGS", "Value": {"Ref": "ModeloEmbeddings"}},
              {"Name": "S20_USUARIOS", "Value": {"Ref": "Usuarios"}},
              {"Name": "S20_DB_HOST", "Value": {"Fn::GetAtt": ["BaseDatos", "Endpoint.Address"]}},
              {"Name": "S20_DB_USER", "Value": "s20"}, {"Name": "S20_DB_NAME", "Value": "s20_agente"}
            ],
            "Secrets": [
              {"Name": "S20_DB_PASSWORD", "ValueFrom": {"Fn::Join": ["", [{"Fn::GetAtt": ["BaseDatos", "MasterUserSecret.SecretArn"]}, ":password::"]]}},
              {"Fn::If": ["ConClaveModelo", {"Name": "GOOGLE_API_KEY", "ValueFrom": {"Ref": "ClaveModeloArn"}}, {"Ref": "AWS::NoValue"}]}
            ],
            "HealthCheck": {
              "Command": ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8020/health', timeout=2)"],
              "Interval": 30, "Timeout": 5, "Retries": 3, "StartPeriod": 40
            },
            "LogConfiguration": {"LogDriver": "awslogs", "Options": {"awslogs-group": {"Ref": "Logs"}, "awslogs-region": {"Ref": "AWS::Region"}, "awslogs-stream-prefix": "api", "mode": "non-blocking", "max-buffer-size": "1m"}}
          },
          {
            "Name": "ejecutor", "Image": {"Ref": "ImageUri"}, "Essential": false,
            "Command": ["sh", "-c", "while true; do python -m agente.cli investigar; sleep 15; done"],
            "DependsOn": [{"ContainerName": "api", "Condition": "HEALTHY"}],
            "Environment": [
              {"Name": "S20_PERFIL", "Value": {"Ref": "Perfil"}}, {"Name": "S20_ALMACEN", "Value": "postgres"},
              {"Name": "S20_FUENTES", "Value": "red"},
              {"Name": "S20_MODELO_CHAT", "Value": {"Ref": "ModeloChat"}}, {"Name": "S20_MODELO_EMBEDDINGS", "Value": {"Ref": "ModeloEmbeddings"}},
              {"Name": "S20_DB_HOST", "Value": {"Fn::GetAtt": ["BaseDatos", "Endpoint.Address"]}},
              {"Name": "S20_DB_USER", "Value": "s20"}, {"Name": "S20_DB_NAME", "Value": "s20_agente"}
            ],
            "Secrets": [
              {"Name": "S20_DB_PASSWORD", "ValueFrom": {"Fn::Join": ["", [{"Fn::GetAtt": ["BaseDatos", "MasterUserSecret.SecretArn"]}, ":password::"]]}},
              {"Fn::If": ["ConClaveModelo", {"Name": "GOOGLE_API_KEY", "ValueFrom": {"Ref": "ClaveModeloArn"}}, {"Ref": "AWS::NoValue"}]}
            ],
            "LogConfiguration": {"LogDriver": "awslogs", "Options": {"awslogs-group": {"Ref": "Logs"}, "awslogs-region": {"Ref": "AWS::Region"}, "awslogs-stream-prefix": "ejecutor", "mode": "non-blocking", "max-buffer-size": "1m"}}
          }
        ]
      }
    },
    "Servicio": {
      "Type": "AWS::ECS::Service", "DependsOn": ["RutaInternet", "Asociacion", "AgenteHaciaDatos", "DatosDesdeAgente"],
      "Properties": {
        "ServiceName": {"Ref": "Lab"}, "Cluster": {"Ref": "Cluster"}, "TaskDefinition": {"Ref": "Tarea"},
        "DesiredCount": 1, "LaunchType": "FARGATE", "PlatformVersion": "1.4.0",
        "DeploymentConfiguration": {"MinimumHealthyPercent": 0, "MaximumPercent": 100, "DeploymentCircuitBreaker": {"Enable": true, "Rollback": true}},
        "NetworkConfiguration": {"AwsvpcConfiguration": {"AssignPublicIp": "ENABLED", "Subnets": [{"Ref": "SubredPublica"}], "SecurityGroups": [{"Ref": "FirewallAgente"}]}}
      }
    }
  },
  "Outputs": {
    "Cluster": {"Value": {"Ref": "Cluster"}}, "Service": {"Value": {"Fn::GetAtt": ["Servicio", "Name"]}},
    "LogGroup": {"Value": {"Ref": "Logs"}}, "ImageUri": {"Value": {"Ref": "ImageUri"}},
    "BaseDatos": {"Value": {"Fn::GetAtt": ["BaseDatos", "Endpoint.Address"]}, "Description": "Solo resoluble dentro de la VPC"},
    "SecretoBaseDatos": {"Value": {"Fn::GetAtt": ["BaseDatos", "MasterUserSecret.SecretArn"]}, "Description": "Lo crea y lo borra RDS con la instancia"}
  }
}
