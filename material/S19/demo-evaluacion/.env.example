# Copia este archivo a .env (ignorado por Git) y rellena solo lo que vayas a usar.
# Con los valores por defecto todo funciona en el perfil `doble`: sin claves y sin coste.
# Una variable vacía cuenta como no definida y toma el valor por defecto.
# Para tener varios archivos (por ejemplo uno por pareja de modelos) sin copiarlos sobre .env:
#   python s19.py <comando> --env .env.otro     (fija S19_ENV_FILE para ese comando)
#   (cd evaluador && uv run python evaluar.py … --env ../.env.otro)

# --- Perfil ---------------------------------------------------------------
# doble = embeddings por hash + generador extractivo locales. NO mide ningún modelo.
# real  = modelos reales, SIEMPRE a través de OpenRouter. Los comandos que gastan exigen --execute.
S19_PERFIL=doble

# --- PostgreSQL + pgvector (docker compose up -d) ---------------------------
# Contenedor local de práctica en un puerto no estándar; credenciales ficticias.
S19_DATABASE_URL=postgresql://s19:s19_aula_local@127.0.0.1:54519/s19_rag

# --- OpenRouter: el único proveedor del perfil real --------------------------
# Una sola clave para modelos de OpenAI, Anthropic, Google y otros: https://openrouter.ai/keys
# Los modelos se escriben como proveedor/modelo (catálogo: https://openrouter.ai/models).
# Cada vez que cambies un modelo: `python s19.py catalogo` (gratis) y `python s19.py preflight`.
# OPENROUTER_API_KEY=
S19_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Embeddings del RAG -----------------------------------------------------
# Regla: el mismo modelo, dimensión y plantilla al indexar y al consultar. Si cambias
# cualquiera de ellos se crea OTRO índice: vuelve a `ingestar` y a `calibrar --fijar`.
# Anthropic no tiene modelos de embeddings; usa los de OpenAI, Google, Qwen, Mistral, etc.
S19_EMBEDDING_MODEL=openai/text-embedding-3-small
# Longitud de los vectores. Con ENVIAR_DIM=true se pide al modelo (OpenAI 3 y Gemini lo admiten).
# Si el modelo no admite reducirla, pon ENVIAR_DIM=false y aquí su dimensión nativa
# (el programa avisa con la cifra correcta si no coincide).
S19_EMBEDDING_DIM=768
S19_EMBEDDING_ENVIAR_DIM=true
# Cómo se presenta el texto al modelo. {titulo} y {texto}; \n es un salto de línea.
# Algunos modelos esperan prefijos. Por ejemplo, para google/gemini-embedding-2:
#   S19_EMBEDDING_PLANTILLA_DOCUMENTO=title: {titulo} | text: {texto}
#   S19_EMBEDDING_PLANTILLA_CONSULTA=task: question answering | query: {texto}
S19_EMBEDDING_PLANTILLA_DOCUMENTO={titulo}\n{texto}
S19_EMBEDDING_PLANTILLA_CONSULTA={texto}
# Proveedores de OpenRouter en orden fijo, sin cambios automáticos (vacío = enrutado por defecto).
S19_EMBEDDING_PROVEEDORES=
# Campos extra de OpenRouter en JSON para cada petición de embeddings (vacío = ninguno).
S19_EMBEDDING_EXTRA=

# --- Generación del RAG -------------------------------------------------------
# Cualquier modelo de chat: google/…, openai/…, anthropic/…, meta-llama/…
S19_GEN_MODEL=google/gemini-4-hydrogen
# Gemini 4 puede razonar antes de responder y esos tokens cuentan dentro del máximo: deja margen.
S19_GEN_MAX_TOKENS=2048
# Vacío = no se envía. Algunos modelos (varios de OpenAI y Anthropic) no la admiten;
# `preflight` avisa según el catálogo.
S19_GEN_TEMPERATURE=0
# Fija quién sirve el modelo (por ejemplo Google o Google AI Studio) para que dos ejecuciones
# comparables usen la misma infraestructura. Vacío = OpenRouter elige.
S19_GEN_PROVEEDORES=
# Campos extra de OpenRouter en JSON. Por defecto, razonamiento bajo: con razonamiento libre,
# Gemini 4 Hydrogen llegó a gastar los 2048 tokens pensando y devolvió respuestas vacías.
# {} lo quita. Si una respuesta agota el máximo, queda el aviso max_tokens_agotado.
S19_GEN_EXTRA={"reasoning": {"effort": "low"}}

# --- Parámetros comunes de la comparación A/B -------------------------------
# chunk_size lo fija cada variante de datos/configuraciones.json (también admite gen_modelo).
# S19_CHUNK_SIZE=320   # valor base, solo se usa fuera de las variantes A/B
S19_CHUNK_OVERLAP=0
S19_K_FRAGMENTOS=12
S19_K_CONTEXTO=4
S19_PROMPT_VERSION=v1
# S19_UMBRAL_EVIDENCIA=   # si no se define, se usa datos/calibracion.json del perfil y modelo

# --- Evaluador aislado (carpeta evaluador/, solo perfil real) ----------------
# También por OpenRouter. Conviene un juez de OTRA familia que el generador, y el MISMO juez
# en las dos ejecuciones que se comparan. Ragas le pide la salida en JSON (response_format).
S19_EVAL_LLM_MODEL=anthropic/claude-opus-5.5
S19_EVAL_EMBEDDING_MODEL=openai/text-embedding-3-small
S19_EVAL_MAX_TOKENS=4096
S19_EVAL_LLM_PROVEEDORES=
S19_EVAL_EMBEDDING_PROVEEDORES=
# Campos extra en JSON para el juez, y parámetros que se quitan de sus peticiones
# Ragas siempre envía temperature y top_p. Los que el catálogo (tarifas.json) dice que el juez no
# admite se quitan solos (Opus 5.5 no admite ninguno de los dos); aquí puedes quitar otros.
S19_EVAL_LLM_EXTRA=
S19_EVAL_QUITAR_PARAMETROS=

# --- Langfuse (opcional) -----------------------------------------------------
S19_LANGFUSE=off
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
