# Copia este archivo a .env (ignorado por Git) y rellena solo lo que vayas a usar.
# Con los valores por defecto todo funciona en el perfil `doble`: sin claves y sin coste.

# --- Perfil ---------------------------------------------------------------
# doble = embeddings por hash + generador extractivo locales. NO mide ningún modelo.
# real  = API de Gemini. Los comandos que gastan exigen además --execute.
S19_PERFIL=doble

# --- PostgreSQL + pgvector (docker compose up -d) ---------------------------
# Contenedor local de práctica en un puerto no estándar; credenciales ficticias.
S19_DATABASE_URL=postgresql://s19:s19_aula_local@127.0.0.1:54519/s19_rag

# --- Modelos del RAG (solo perfil real) -------------------------------------
# Regla: el mismo modelo y la misma dimensión al indexar y al consultar.
S19_EMBEDDING_MODEL=gemini-embedding-2
S19_EMBEDDING_DIM=768
S19_GEN_MODEL=gemini-3.5-flash-lite
# GEMINI_API_KEY=

# --- Parámetros comunes de la comparación A/B -------------------------------
# chunk_size lo fija cada variante de datos/configuraciones.json.
S19_CHUNK_OVERLAP=0
S19_K_FRAGMENTOS=12
S19_K_CONTEXTO=4
S19_PROMPT_VERSION=v1
# S19_UMBRAL_EVIDENCIA=   # si no se define, se usa datos/calibracion.json del perfil

# --- Evaluador aislado (carpeta evaluador/, solo perfil real) ----------------
# openai_compat = endpoint de Gemini compatible con OpenAI (cliente asíncrono; cuenta tokens)
# google_genai  = SDK google-genai con instructor asíncrono (no expone tokens: coste «sin dato»)
# Ojo: la llamada de la guía «Ragas con Gemini» con cliente síncrono falla en ascore con
# ragas==0.4.3 (ver evaluador/README.md).
S19_EVAL_RUTA=openai_compat
S19_EVAL_LLM_MODEL=gemini-3.8-flash
S19_EVAL_EMBEDDING_MODEL=gemini-embedding-001
S19_EVAL_MAX_TOKENS=4096

# --- Langfuse (opcional) -----------------------------------------------------
S19_LANGFUSE=off
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
